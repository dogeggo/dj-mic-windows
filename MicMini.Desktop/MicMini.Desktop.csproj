<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\dji-mimo.ico</ApplicationIcon>
    <AssemblyName>MicMini.Desktop</AssemblyName>
    <Version>0.3.1</Version>
    <Description>DJI Mic 系列 Windows USB 参数控制与电脑录音</Description>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Resource Include="Assets\dji-mimo.ico" />
    <Resource Include="Assets\dji-mimo-official-round.png" />
  </ItemGroup>
</Project>
